<?xml version="1.0" encoding="utf-8"?>
<!--
  Aimdot Game Bar widget: a C# UWP XAML app (Xbox Game Bar widgets have to be UWP XAML - Rust can't make one).
  Based on Microsoft's WidgetSampleCS (https://github.com/microsoft/XboxGameBarSamples). Build: build.ps1, or open
  CrosshairWidget.sln in Visual Studio (workload "Universal Windows Platform development" / UWP tools).
-->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{42BAC6C1-AC9B-4E44-8130-AA1A6276A6E1}</ProjectGuid>
    <OutputType>AppContainerExe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <!-- Internal names stay "CrosshairWidget" (like the crates); the exe and everything users see say Aimdot -->
    <RootNamespace>CrosshairWidget</RootNamespace>
    <AssemblyName>AimdotWidget</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <!-- build.ps1 passes the newest installed Windows SDK; this is the fallback. Game Bar needs 17763+. -->
    <TargetPlatformVersion Condition=" '$(TargetPlatformVersion)' == '' ">10.0.22621.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <MinimumVisualStudioVersion>14</MinimumVisualStudioVersion>
    <FileAlignment>512</FileAlignment>
    <ProjectTypeGuids>{A5A43C5B-DE2A-4C0C-9213-0A381AF9435A};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <WindowsXamlEnableOverview>true</WindowsXamlEnableOverview>
    <!-- Signing is done by build.ps1 with signtool (Certum certificate), not by Visual Studio -->
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>
  <PropertyGroup>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <NoWarn>;2008</NoWarn>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="CrosshairPage.xaml.cs">
      <DependentUpon>CrosshairPage.xaml</DependentUpon>
    </Compile>
    <Compile Include="Picture.cs" />
    <Compile Include="WidgetLog.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\SplashScreen.png" />
    <!-- Game Bar's own icons for the widget (PublicFolder="GameBar"): https://learn.microsoft.com/en-us/gaming/game-bar/guide/icons -->
    <Content Include="GameBar\Icons\icon.targetsize-16.png" />
    <Content Include="GameBar\Icons\icon.targetsize-20.png" />
    <Content Include="GameBar\Icons\icon.targetsize-24.png" />
    <Content Include="GameBar\Icons\icon.targetsize-32.png" />
    <Content Include="GameBar\Icons\icon.targetsize-44.png" />
    <Content Include="GameBar\Icons\icon.targetsize-256.png" />
    <Content Include="Properties\Default.rd.xml" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="CrosshairPage.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <!-- Versions checked on nuget.org, 10 Nov 2026 -->
    <PackageReference Include="Microsoft.Gaming.XboxGameBar">
      <Version>7.3.2607010</Version>
    </PackageReference>
    <!-- 6.2.14 (.NET Native 2.2), NOT 6.2.15: 6.2.15's compiler (2.2.15-rel-2605-2102) stamps .NET Native
         Framework/Runtime 2.3 >= 2.3.60521.0 into the MSIX, but the only public 2.3 packages (its runtime package
         and runtime.win10-x64.Microsoft.Net.Native.SharedLibrary 2.3.15-rel-2605-2102) are 2.3.60518.0 inside, so
         the widget could only install where the Store had already put 2.3 on the PC (1.0.3 / 1.0.4: 0x80073CF3 on
         an LTSC PC and on a normal one, 11-12 Nov 2026). 2.2 matches: Framework 2.2.29512.0, Runtime 2.2.28604.0. -->
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform">
      <Version>6.2.14</Version>
    </PackageReference>
    <!-- The .NET Native 2.2 framework package itself (Microsoft.NET.Native.Framework.2.2.appx), so the build puts it
         in Dependencies\x64 and the installer can ship it (build.ps1 -> out\deps). The same build (31116) as
         6.2.14's compiler 2.2.12-rel-31116-00, which brings the runtime package. -->
    <PackageReference Include="runtime.win10-x64.Microsoft.Net.Native.SharedLibrary" Condition="'$(Platform)' == 'x64'">
      <Version>2.2.8-rel-31116-00</Version>
    </PackageReference>
  </ItemGroup>
  <!-- From Microsoft's sample: the Game Bar package picks its native parts by this -->
  <PropertyGroup>
    <XboxGameBar-Platform Condition="'$(Platform)' == 'x86'">win32</XboxGameBar-Platform>
    <XboxGameBar-Platform Condition="'$(Platform)' != 'x86'">$(Platform)</XboxGameBar-Platform>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '14.0' ">
    <VisualStudioVersion>14.0</VisualStudioVersion>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
</Project>
