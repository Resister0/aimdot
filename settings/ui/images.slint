// Images page: import pictures, the library with thumbnails, size / look of the chosen image.
// Rust side: src/images.rs (global Imgs). Also holds small parts the Painter page shares (Field, PTitle, PIc).
import { T, Icon, Btn, Switch, Slider, Seg, Opt, Card, Row, Note, LiftTile } from "theme.slint";

export global PIc {
    out property <string> image: "M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z M4 16l5-5 4 4 2-2 5 5 M15 8.5h.01";
    out property <string> brush: "M15 4l5 5L9 20H4v-5z M13 6l5 5";
    out property <string> undo: "M9 14L4 9l5-5 M4 9h10a6 6 0 0 1 0 12h-3";
    out property <string> redo: "M15 14l5-5-5-5 M20 9H10a6 6 0 0 0 0 12h3";
    out property <string> trash: "M4 7h16 M10 11v6 M14 11v6 M6 7l1 13h10l1-13 M9 7V4h6v3";
    out property <string> close: "M7 7l10 10 M17 7L7 17";
    out property <string> import: "M12 4v12 M7 11l5 5 5-5 M4 20h16";
    out property <string> save: "M5 4h11l4 4v12H4V4z M8 4v5h7V4 M8 20v-6h8v6";
    out property <string> plus: "M12 5v14 M5 12h14";
    out property <string> minus: "M5 12h14";
    out property <string> tick: "M5 12l4 4 10-10";
    out property <string> eye: "M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6z";
    out property <string> eye-off: "M3 3l18 18 M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4.2 M6.6 6.6A17 17 0 0 0 2 12s3.5 7 10 7a9.6 9.6 0 0 0 5.4-1.6 M9.9 9.9a3 3 0 0 0 4.2 4.2";
}

export struct ImgItem {
    file: string,   // file name in the library ("Dot.png")
    name: string,   // shown ("Dot")
    img: image,     // thumbnail
    ok: bool,       // the file could be read
    on: bool,       // the current crosshair
}

export global Imgs {
    in property <[ImgItem]> items;
    in property <int> rows;
    in property <string> selected;
    in property <bool> active;        // an image from the library is the crosshair now
    in property <bool> missing;       // ... but its file is gone
    in property <bool> can-edit;      // small enough for the painter
    in property <float> scale: 1;
    in property <bool> smooth: true;
    in property <float> opacity: 1;
    in property <bool> tint;
    in property <string> size-text;
    in property <string> status;
    in property <bool> status-ok: true;
    in property <string> exts;
    in property <bool> can-drop;
    in property <bool> drag-over;      // files are being dragged over the window
    // an SVG waiting for its size
    in property <bool> svg-on;
    in property <string> svg-name;
    in property <string> svg-own-text;  // "24 × 24 px"
    in property <int> svg-own;          // its own size (long side, clamped), px
    in property <int> svg-side;         // the chosen long side, px
    in property <bool> svg-sharp: true;
    in property <image> svg-preview;
    in property <int> svg-preview-w;
    in property <int> svg-preview-h;
    in property <string> svg-text;
    in property <bool> svg-ok: true;
    callback svg-size(int);
    callback svg-set-sharp(bool);
    callback svg-import();
    callback svg-cancel();
    in-out property <string> confirm;  // the file whose "Delete?" is showing
    in-out property <string> path-text;
    callback browse();
    callback import-path(string);
    callback select(string);
    callback delete(string);
    callback num(string, float);
    callback flag(string, bool);
    callback use-design();
    callback edit(string);
}

export component PTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> sub;
    spacing: 4px;
    padding-bottom: 10px;
    Text { text: root.title; font-size: 24px; font-weight: 700 + T.fw; color: T.text; }
    Text { text: root.sub; font-size: 13px; color: T.muted; }
}

// one-line text field in the app's look
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback accepted(string);
    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ti.has-focus ? T.accent : T.line;
    background: T.bg;
    if root.text == "" && !ti.has-focus: Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        color: T.dim;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    ti := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text <=> root.text;
        color: T.text;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        accepted => { root.accepted(self.text); }
    }
}

component Status inherits Note {
    in property <string> msg;
    in property <bool> ok;
    text: root.msg;
    color: root.ok ? T.muted : T.warn;
}

component Tile inherits Rectangle {
    in property <ImgItem> it;
    property <bool> asking: Imgs.confirm == root.it.file;
    property <length> side: min(64px, root.width - 12px);
    height: 108px;
    // Echo's library card feel: lifts on hover, accent edge, presses in
    lt := LiftTile {
        width: parent.width;
        height: parent.height;
        on: root.it.on;
        clicked => {
            Imgs.confirm = "";
            Imgs.select(root.it.file);
        }
        if root.it.ok: Image {
            x: (parent.width - root.side) / 2;
            y: 10px + (64px - root.side) / 2;
            width: root.side;
            height: root.side;
            source: root.it.img;
            image-fit: contain;
            image-rendering: pixelated;
        }
        if !root.it.ok: Text { y: 30px; text: "Can't read"; font-size: 11px; color: T.warn; }
        Text {
            x: 6px;
            y: parent.height - 26px;
            width: parent.width - 12px;
            horizontal-alignment: center;
            text: root.it.name;
            font-size: 11.5px;
            overflow: elide;
            color: root.it.on || lt.hov ? T.text : T.muted;
        }
        // delete: the small x on hover, then "Delete?" to be sure
        if lt.hov && !root.asking: Rectangle {
            x: parent.width - 26px;
            y: 4px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: xta.has-hover ? T.bad : T.bg.with-alpha(0.85);
            Icon { width: 14px; height: 14px; commands: PIc.close; stroke: xta.has-hover ? white : T.text; }
            xta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Imgs.confirm = root.it.file; }
            }
        }
        if root.asking: Rectangle {
            border-radius: 10px;
            background: T.bg.with-alpha(0.92);
            // catches clicks, so "Delete?" doesn't also pick the picture
            TouchArea { }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                padding: 6px;
                Text { text: "Delete?"; font-size: 12.5px; font-weight: 600 + T.fw; color: T.text; horizontal-alignment: center; }
                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    Btn { text: "Yes"; small: true; danger: true; clicked => { Imgs.confirm = ""; Imgs.delete(root.it.file); } }
                    Btn { text: "No"; small: true; clicked => { Imgs.confirm = ""; } }
                }
            }
        }
    }
}

export component ImagesPage inherits VerticalLayout {
    spacing: 14px;
    PTitle { title: "Images"; sub: "Use any picture as your crosshair"; }
    Card {
        title: "Import";
        // the drop zone: lights up while files are dragged over the window
        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Imgs.drag-over ? T.accent : T.line;
            background: Imgs.drag-over ? T.accent.with-alpha(0.08) : transparent;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                HorizontalLayout {
                    alignment: start;
                    Btn { text: "Import a crosshair image (PNG, SVG, JPG…)"; icon: PIc.import; primary: true; clicked => { Imgs.browse(); } }
                }
                Note {
                    text: Imgs.drag-over ? "Let go to import it" : Imgs.can-drop ? "Exported from another crosshair app? Drop the file here or pick it." : "Exported from another crosshair app? Pick the file.";
                    color: Imgs.drag-over ? T.accent : T.muted;
                }
            }
        }
        Note { text: Imgs.exts + ". Transparent PNGs work best. Pictures are copied into Aimdot's image folder as PNG (big ones are made smaller, to 1024 px)."; }
        HorizontalLayout {
            padding-top: 8px;
            spacing: 8px;
            Field {
                horizontal-stretch: 1;
                text <=> Imgs.path-text;
                placeholder: "…or paste the picture's full path here";
                accepted(t) => { Imgs.import-path(t); }
            }
            Btn { text: "Import"; small: true; y: 2px; clicked => { Imgs.import-path(Imgs.path-text); } }
        }
        if Imgs.status != "": Status { msg: Imgs.status; ok: Imgs.status-ok; }
    }
    if Imgs.svg-on: Card {
        title: "SVG size - " + Imgs.svg-name;
        Note { text: "Its own size: " + Imgs.svg-own-text + ". Pick the picture's size in pixels; whole steps of its own size keep thin lines exactly 1 px."; }
        HorizontalLayout {
            padding-top: 8px;
            spacing: 14px;
            // the result at its real size, and 3 times bigger to check the edges
            for zoom in [1, 3]: Rectangle {
                width: 136px;
                height: 136px;
                border-radius: 8px;
                background: T.bg;
                border-width: 1px;
                border-color: T.line;
                clip: true;
                Image {
                    width: min(130px, Imgs.svg-preview-w * zoom * 1px);
                    height: min(130px, Imgs.svg-preview-h * zoom * 1px);
                    source: Imgs.svg-preview;
                    image-fit: contain;
                    image-rendering: pixelated;
                }
                Text { x: 6px; y: parent.height - 18px; text: zoom == 1 ? "real size" : "3×"; font-size: 10.5px; color: T.dim; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: Imgs.svg-text; font-size: 13px; color: Imgs.svg-ok ? T.text : T.warn; wrap: word-wrap; }
                Text { text: "Transparent background, the SVG's centre = the crosshair's centre."; font-size: 12px; color: T.muted; wrap: word-wrap; }
            }
        }
        Row {
            label: "Size";
            val: Imgs.svg-side + " px";
            Slider {
                y: (parent.height - self.height) / 2;
                width: 210px;
                value: Imgs.svg-side;
                lo: 4;
                hi: 256;
                step: 1;
                moved(v) => { Imgs.svg-size(round(v)); }
            }
        }
        Row {
            label: "Quick sizes";
            sub: "Own size and whole steps of it";
            Seg {
                y: (parent.height - self.height) / 2;
                opts: [
                    { label: "½×", value: max(4, round(Imgs.svg-own / 2)) },
                    { label: "Own (" + Imgs.svg-own + " px)", value: Imgs.svg-own },
                    { label: "2×", value: min(256, Imgs.svg-own * 2) },
                    { label: "3×", value: min(256, Imgs.svg-own * 3) },
                    { label: "4×", value: min(256, Imgs.svg-own * 4) },
                ];
                value: Imgs.svg-side;
                picked(v) => { Imgs.svg-size(v); }
            }
        }
        Row {
            label: "Sharp edges";
            sub: Imgs.svg-sharp ? "Crisp pixels - thin lines stay sharp." : "Smooth edges - nicer for round shapes and big sizes.";
            Switch { y: (parent.height - self.height) / 2; on: Imgs.svg-sharp; toggled(v) => { Imgs.svg-set-sharp(v); } }
        }
        HorizontalLayout {
            padding-top: 8px;
            spacing: 8px;
            alignment: start;
            Btn { text: "Import"; icon: PIc.import; primary: true; enabled: Imgs.svg-ok; clicked => { Imgs.svg-import(); } }
            Btn { text: "Cancel"; clicked => { Imgs.svg-cancel(); } }
        }
    }
    Card {
        title: "Your images";
        if Imgs.items.length == 0: Note { text: "No images yet. Import one above, or paint one on the Painter page."; }
        if Imgs.items.length > 0: VerticalLayout {
            padding-top: 6px;
            spacing: 8px;
            for row in Imgs.rows: HorizontalLayout {
                spacing: 8px;
                for i in 5: Rectangle {
                    property <int> n: row * 5 + i;
                    height: 108px;
                    if n < Imgs.items.length: Tile { width: parent.width; height: parent.height; it: Imgs.items[n]; }
                }
            }
            Note { text: "Click a picture to use it as the crosshair."; }
        }
    }
    if Imgs.missing: Card {
        Note { text: "The chosen picture's file is gone - pick another one."; color: T.warn; }
    }
    if Imgs.active: Card {
        title: "Size and look";
        Row {
            label: "Size";
            val: round(Imgs.scale * 100) + " %";
            Slider {
                y: (parent.height - self.height) / 2;
                width: 210px;
                value: Imgs.scale;
                lo: 0.1;
                hi: 4;
                step: 0.05;
                moved(v) => { Imgs.num("img_scale", v); }
            }
        }
        Row {
            label: "Quick sizes";
            sub: Imgs.size-text;
            Seg {
                y: (parent.height - self.height) / 2;
                opts: [{ label: "50 %", value: 50 }, { label: "100 %", value: 100 }, { label: "200 %", value: 200 }, { label: "300 %", value: 300 }, { label: "400 %", value: 400 }];
                value: round(Imgs.scale * 100);
                picked(v) => { Imgs.num("img_scale", v / 100); }
            }
        }
        Row {
            label: "Smooth scaling";
            sub: Imgs.smooth ? "Soft edges - good for photos and drawings." : "Crisp pixels - best for pixel art (use 200 %, 300 % … for even pixels).";
            Switch { y: (parent.height - self.height) / 2; on: Imgs.smooth; toggled(v) => { Imgs.flag("img_smooth", v); } }
        }
        Row {
            label: "Opacity";
            val: round(Imgs.opacity * 100) + " %";
            Slider {
                y: (parent.height - self.height) / 2;
                width: 210px;
                value: Imgs.opacity;
                lo: 0.05;
                hi: 1;
                step: 0.01;
                moved(v) => { Imgs.num("img_opacity", v); }
            }
        }
        Row {
            label: "Recolor with the crosshair color";
            sub: "Uses the color (and RGB rainbow) from the Designer page.";
            Switch { y: (parent.height - self.height) / 2; on: Imgs.tint; toggled(v) => { Imgs.flag("img_tint", v); } }
        }
        HorizontalLayout {
            padding-top: 8px;
            spacing: 8px;
            alignment: start;
            if Imgs.can-edit: Btn { text: "Edit in the painter"; icon: PIc.brush; small: true; clicked => { Imgs.edit(Imgs.selected); } }
            Btn { text: "Use the Designer instead"; small: true; clicked => { Imgs.use-design(); } }
        }
    }
}
