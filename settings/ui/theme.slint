// Echo's look (copied from Echo's prototype-native/ui/theme.slint + settings.slint: colours, buttons, switch,
// slider, segmented control, nav buttons, top glow, colour picker). Same author, so the code can move here.

export global T {
    in-out property <int> fw: 0;
    in-out property <color> bg: #0d0d10;
    in-out property <color> rail: #0a0a0c;
    in-out property <color> panel: #16161a;
    in-out property <color> panel2: #1e1e23;
    in-out property <color> line: #26262c;
    in-out property <color> hover: #34343c;
    in-out property <color> text: #f5f5f7;
    in-out property <color> muted: #a0a0ab;
    in-out property <color> dim: #6b6b76;
    // Aimdot's own coral (theme "", src/theme.rs); Rust puts the picked theme in here
    in-out property <color> accent: #ef6a4c;
    in-out property <color> accent2: #f49782;
    // text / icons ON the accent or grad (Echo, 11 Nov 2026): near-black on very light accents (Mono, Sand, Lime...)
    in-out property <color> on-accent: #ffffff;
    out property <color> ok: #34d399;
    out property <color> bad: #fb5c7c;
    out property <color> warn: #f0a93a;
    in-out property <color> g0: #ff8f6b;
    in-out property <color> g1: #ef6a4c;
    in-out property <color> g2: #e0485e;
    out property <brush> grad: @linear-gradient(135deg, g0 0%, g1 55%, g2 100%);
    out property <length> radius: 14px;
    // Aimdot is a precise tool: corners one step sharper than Echo's (Echo: cards 12-14, buttons 10, tooltips 7)
    out property <length> r-card: 8px;
    out property <length> r-tile: 6px;
    out property <length> r-btn: 6px;
    out property <length> r-small: 5px;
    // Echo: .15 s for buttons, .18 s for cards (the lift); the shadow is NOT animated (an animated blur smears)
    out property <duration> fade: 150ms;
    out property <duration> lift: 180ms;
    out property <duration> press: 90ms;
    // Echo's lesson (11 Nov 2026, idle CPU): true while RGB turns the theme colours (src/main.rs rgb_tick). The colour
    // fades (`animate background / border-color / color`) are then off (`enabled: !T.rgb-live`): every hue step would
    // restart them and the window would redraw at the monitor's full rate nonstop (60-165 fps) instead of once per
    // step. A 0 ms duration still costs a 2nd frame per step; enabled: false doesn't. Opacity / movement fades stay.
    in-out property <bool> rgb-live;
}

