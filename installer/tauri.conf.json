{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aimdot",
  "mainBinaryName": "aimdot",
  "version": "0.1.0",
  "identifier": "app.sonela.aimdot",
  "build": {},
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/icons/aimdot-256.png", "../assets/icons/aimdot.ico"],
    "publisher": "Resister0",
    "copyright": "© 2026 Resister0",
    "category": "Utility",
    "shortDescription": "Aimdot - crosshair overlay",
    "longDescription": "Aimdot draws a crosshair over your games. Very light: almost no memory or CPU while you play.",
    "licenseFile": "notice.txt",
    "resources": {
      "../target/release/aimdot-settings.exe": "aimdot-settings.exe",
      "../LICENSE": "LICENSE.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "hooks.nsh",
        "installerIcon": "../assets/icons/aimdot.ico",
        "headerImage": "header.bmp",
        "sidebarImage": "sidebar.bmp"
      }
    }
  }
}
